{
  "name": "gyroll",
  "version": "1.1.0",
  "private": true,
  "description": "GYROLL — an endless 3D marble run you steer by tilting your phone. One self-contained HTML file.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://gyroll.vercel.app/",
  "repository": { "type": "git", "url": "git+https://github.com/ErwannRobin/gyro.git" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test": "playwright test",
    "ci": "npm run check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "engines": { "node": ">=20" }
}
